    function handlePhotoUpload(event) {
      const file = event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        const img = new Image();
        img.onload = function() {
          applyIndustrialWatermark(img);
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
      // Reset input
      event.target.value = '';
    }

    function applyIndustrialWatermark(image) {
      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d');

      // Max dimension limit to keep PDF small & fast
      const maxDim = 1200;
      let width = image.width;
      let height = image.height;

      if (width > maxDim || height > maxDim) {
        if (width > height) {
          height = Math.round((height * maxDim) / width);
          width = maxDim;
        } else {
          width = Math.round((width * maxDim) / height);
          height = maxDim;
        }
      }

      canvas.width = width;
      canvas.height = height;

      // Draw base image
      ctx.drawImage(image, 0, 0, width, height);

      // Add high-contrast semi-transparent bottom banner
      const bannerHeight = Math.max(64, Math.round(height * 0.12));
      ctx.fillStyle = 'rgba(11, 25, 44, 0.88)';
      ctx.fillRect(0, height - bannerHeight, width, bannerHeight);

      // Orange boundary line
      ctx.strokeStyle = '#ff6500';
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.moveTo(0, height - bannerHeight);
      ctx.lineTo(width, height - bannerHeight);
      ctx.stroke();

      // Overlaid Metadata Text
      const serial = document.getElementById('panelSerialNo').value || 'AA-FAT-2026';
      const engineer = document.getElementById('engineerName').value || 'QC Engineer';
      const location = document.getElementById('inspectionLocation').value || 'Chikhali Works, Pune';
      const dateStr = new Date().toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' });

      ctx.fillStyle = '#ffffff';
      ctx.font = `bold ${Math.round(bannerHeight * 0.28)}px Inter, sans-serif`;
      ctx.fillText(`ARYAVARTA AUTOMATION • FAT EVIDENCE • PANEL: ${serial}`, 16, height - bannerHeight + (bannerHeight * 0.4));

      ctx.fillStyle = '#cbd5e1';
      ctx.font = `${Math.round(bannerHeight * 0.22)}px monospace`;
      ctx.fillText(`INSPECTOR: ${engineer} | LOC: ${location} | ${dateStr}`, 16, height - bannerHeight + (bannerHeight * 0.78));

      // Export compressed base64 JPEG
      const watermarkedBase64 = canvas.toDataURL('image/jpeg', 0.82);
      attachedPhotos.push({
        dataUrl: watermarkedBase64,
        timestamp: dateStr,
        serial: serial
      });

      renderPhotosGallery();
      showToast("Photo watermarked with Panel ID and Timestamp!", "success");
    }

