<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Aryavarta Automation - Voice FAT & Digital Commissioning App</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  
  <!-- jsPDF and AutoTable for Instant PDF Generation -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
  
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              navy: '#0b192c',
              steel: '#1e3e62',
              orange: '#ff6500',
              accent: '#008170',
              card: '#162840',
              darker: '#070f1e'
            }
          },
          animation: {
            'pulse-slow': 'pulse 2.5s cubic-bezier(0.4, 0, 0.6, 1) infinite',
            'wave': 'waveBar 1.2s ease-in-out infinite alternate',
          },
          keyframes: {
            waveBar: {
              '0%': { height: '8px' },
              '100%': { height: '36px' }
            }
          }
        }
      }
    };
  </script>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap');
    
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: #070f1e;
      color: #e2e8f0;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }

    .font-mono-code {
      font-family: 'JetBrains Mono', monospace;
    }

    /* Custom scrollbar for shop-floor touch screens */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #0b192c;
    }
    ::-webkit-scrollbar-thumb {
      background: #1e3e62;
      border-radius: 4px;
    }

    /* Signature canvas styling */
    .signature-canvas {
      touch-action: none;
      background: #f8fafc;
      cursor: crosshair;
    }

    /* Audio wave bars */
    .wave-bar:nth-child(1) { animation-delay: 0.1s; }
    .wave-bar:nth-child(2) { animation-delay: 0.25s; }
    .wave-bar:nth-child(3) { animation-delay: 0.4s; }
    .wave-bar:nth-child(4) { animation-delay: 0.15s; }
    .wave-bar:nth-child(5) { animation-delay: 0.3s; }
  </style>
</head>
<body class="min-h-screen flex flex-col bg-brand-darker text-slate-100 overflow-x-hidden">

  <!-- Header Bar -->
  <header class="bg-brand-navy border-b border-brand-steel/60 sticky top-0 z-40 shadow-xl">
    <div class="max-w-7xl mx-auto px-3 sm:px-6 py-2.5 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-brand-orange to-orange-600 flex items-center justify-center font-black text-xl text-white shadow-lg shadow-orange-500/20">
          A
        </div>
        <div>
          <div class="flex items-center space-x-2">
            <h1 class="font-bold text-base sm:text-lg tracking-tight text-white flex items-center gap-1.5">
              ARYAVARTA AUTOMATION
              <span class="text-xs px-2 py-0.5 rounded bg-brand-orange/20 text-brand-orange font-semibold border border-brand-orange/30">FAT PRO</span>
            </h1>
          </div>
          <p class="text-[11px] sm:text-xs text-slate-400 truncate max-w-[210px] sm:max-w-none">
            ISO 9001:2015 & ISO 14001:2015 Certified Panels • Pune Works
          </p>
        </div>
      </div>

      <!-- Live Status Badges -->
      <div class="flex items-center space-x-2 text-xs">
        <div id="netStatusBadge" class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="hidden md:inline font-medium">Online</span>
        </div>

        <div id="micStatusBadge" class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-800 text-slate-400 border border-slate-700">
          <i data-lucide="mic-off" class="w-3.5 h-3.5"></i>
          <span class="hidden md:inline font-medium" id="micStatusText">Mic Idle</span>
        </div>

        <div id="cloudSyncBadge" onclick="switchTab('settings')" class="cursor-pointer flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-blue-500/10 text-blue-400 border border-blue-500/20 hover:bg-blue-500/20 transition">
          <i data-lucide="sheet" class="w-3.5 h-3.5"></i>
          <span class="font-medium" id="syncCountBadge">Sheets Synced</span>
        </div>
      </div>
    </div>
    
    <!-- Navigation Tabs -->
    <nav class="flex border-t border-brand-steel/40 bg-brand-navy/95 overflow-x-auto text-xs sm:text-sm font-medium">
      <button onclick="switchTab('inspection')" id="tab-inspection" class="tab-btn flex-1 min-w-[100px] py-3 px-3 text-center border-b-2 border-brand-orange text-brand-orange flex items-center justify-center gap-1.5 transition">
        <i data-lucide="clipboard-check" class="w-4 h-4"></i>
        <span>FAT Checklist</span>
      </button>
      <button onclick="switchTab('voice')" id="tab-voice" class="tab-btn flex-1 min-w-[100px] py-3 px-3 text-center border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex items-center justify-center gap-1.5 transition">
        <i data-lucide="mic" class="w-4 h-4"></i>
        <span>Voice HUD</span>
      </button>
      <button onclick="switchTab('evidence')" id="tab-evidence" class="tab-btn flex-1 min-w-[100px] py-3 px-3 text-center border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex items-center justify-center gap-1.5 transition">
        <i data-lucide="camera" class="w-4 h-4"></i>
        <span>Sign & Proof</span>
      </button>
      <button onclick="switchTab('reports')" id="tab-reports" class="tab-btn flex-1 min-w-[100px] py-3 px-3 text-center border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex items-center justify-center gap-1.5 transition">
        <i data-lucide="file-text" class="w-4 h-4"></i>
        <span>Reports & Logs</span>
      </button>
      <button onclick="switchTab('settings')" id="tab-settings" class="tab-btn flex-1 min-w-[100px] py-3 px-3 text-center border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex items-center justify-center gap-1.5 transition">
        <i data-lucide="settings" class="w-4 h-4"></i>
        <span>Google Cloud</span>
      </button>
    </nav>
  </header>

  <!-- Main Content Body -->
  <main class="flex-1 max-w-7xl w-full mx-auto p-3 sm:p-6">
    <!-- Toast Notification Banner -->
    <div id="toast" class="fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none max-w-md w-full px-4">
      <div id="toastInner" class="flex items-center gap-3 p-4 rounded-xl shadow-2xl border text-sm backdrop-blur-md">
        <i id="toastIcon" data-lucide="info" class="w-5 h-5 flex-shrink-0"></i>
        <div id="toastMessage" class="flex-1 font-medium">Notification message</div>
      </div>
    </div>

    <!-- TAB 1: NEW INSPECTION / CHECKLIST -->
    <section id="pane-inspection" class="space-y-6">
      
      <!-- Panel Information & Setup Card -->
      <div class="bg-brand-card/70 backdrop-blur border border-brand-steel/60 rounded-2xl p-4 sm:p-6 shadow-xl">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-brand-steel/50">
          <div>
            <h2 class="text-lg font-bold text-white flex items-center gap-2">
              <i data-lucide="cpu" class="w-5 h-5 text-brand-orange"></i>
              Panel Project Specification
            </h2>
            <p class="text-xs text-slate-400">Select standard Aryavarta panel type to load factory test criteria.</p>
          </div>
          <div class="flex items-center gap-2">
            <button onclick="resetInspectionForm()" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 flex items-center gap-1.5 transition">
              <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
              New Inspection
            </button>
            <button onclick="startVoiceHUDDirectly()" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-gradient-to-r from-brand-orange to-amber-600 hover:opacity-90 text-white shadow-md shadow-orange-500/20 flex items-center gap-1.5 transition">
              <i data-lucide="headphones" class="w-3.5 h-3.5"></i>
              Launch Hands-Free Voice
            </button>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-4 text-xs">
          <div>
            <label class="block font-medium text-slate-300 mb-1.5">Panel Category / Product Line</label>
            <select id="panelTypeSelect" onchange="loadChecklistTemplate(this.value)" class="w-full bg-brand-navy border border-brand-steel rounded-xl px-3 py-2.5 text-white focus:outline-none focus:border-brand-orange transition">
              <option value="vfd">VFD Control Panel (Speed, Ramp, Modbus, 4-20mA)</option>
              <option value="mcc">MCC Panel (Motor Control Center - Busbar, Star-Delta)</option>
              <option value="pcc">PCC Panel (Power Control Center - ACB, Shunt, Clearance)</option>
              <option value="apfc">APFC Panel (Automatic Power Factor Correction)</option>
              <option value="plc">PLC & SCADA Automation Panel (SMPS, DI/DO, 4-20mA)</option>
            </select>
          </div>

          <div>
            <label class="block font-medium text-slate-300 mb-1.5">Panel Serial Number</label>
            <input type="text" id="panelSerialNo" value="AA-2026-VFD-108" class="w-full bg-brand-navy border border-brand-steel rounded-xl px-3 py-2.5 text-white font-mono-code focus:outline-none focus:border-brand-orange transition" placeholder="e.g. AA-2026-MCC-042">
          </div>

          <div>
            <label class="block font-medium text-slate-300 mb-1.5">Client / Plant Name</label>
            <input type="text" id="clientName" value="Kalyani Ethanol & Bio-Refinery Ltd." class="w-full bg-brand-navy border border-brand-steel rounded-xl px-3 py-2.5 text-white focus:outline-none focus:border-brand-orange transition" placeholder="e.g. Baramati Agro Sugar Division">
          </div>

          <div>
            <label class="block font-medium text-slate-300 mb-1.5">PO / Work Order Number</label>
            <input type="text" id="poNumber" value="PO-IND-9942/26" class="w-full bg-brand-navy border border-brand-steel rounded-xl px-3 py-2.5 text-white font-mono-code focus:outline-none focus:border-brand-orange transition">
          </div>

          <div>
            <label class="block font-medium text-slate-300 mb-1.5">Testing Engineer Name / ID</label>
            <input type="text" id="engineerName" value="Er. Rohit Sawant (ID: AA-QC-09)" class="w-full bg-brand-navy border border-brand-steel rounded-xl px-3 py-2.5 text-white focus:outline-none focus:border-brand-orange transition">
          </div>

          <div>
            <label class="block font-medium text-slate-300 mb-1.5">Testing Facility Location</label>
            <input type="text" id="inspectionLocation" value="Chikhali Works (Bay 2), Pune" class="w-full bg-brand-navy border border-brand-steel rounded-xl px-3 py-2.5 text-white focus:outline-none focus:border-brand-orange transition">
          </div>
        </div>
      </div>

      <!-- Checklist Progress Tracker -->
      <div class="bg-brand-navy/80 border border-brand-steel/50 rounded-xl p-4 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-4">
          <div class="text-sm">
            <span class="text-slate-400">Total Steps:</span>
            <span id="statTotalSteps" class="font-bold text-white ml-1">0</span>
          </div>
          <div class="text-sm">
            <span class="text-emerald-400">Passed:</span>
            <span id="statPassedSteps" class="font-bold text-emerald-400 ml-1">0</span>
          </div>
          <div class="text-sm">
            <span class="text-rose-400">Failed:</span>
            <span id="statFailedSteps" class="font-bold text-rose-400 ml-1">0</span>
          </div>
          <div class="text-sm">
            <span class="text-amber-400">Pending:</span>
            <span id="statPendingSteps" class="font-bold text-amber-400 ml-1">0</span>
          </div>
        </div>

        <div class="flex-1 min-w-[200px] max-w-md">
          <div class="w-full bg-slate-800 rounded-full h-2.5 overflow-hidden">
            <div id="checklistProgressBar" class="bg-gradient-to-r from-brand-orange to-emerald-500 h-2.5 rounded-full transition-all duration-300" style="width: 0%"></div>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button onclick="markAllPassed()" class="px-3 py-1.5 rounded-lg text-xs bg-emerald-500/20 text-emerald-300 hover:bg-emerald-500/30 border border-emerald-500/30 transition">
            Auto-Verify Defaults
          </button>
        </div>
      </div>

      <!-- Interactive Checklist Table -->
      <div class="bg-brand-card/90 border border-brand-steel/60 rounded-2xl overflow-hidden shadow-xl">
        <div class="p-4 border-b border-brand-steel/50 flex items-center justify-between">
          <h3 class="font-bold text-sm text-white flex items-center gap-2">
            <i data-lucide="list-checks" class="w-4 h-4 text-brand-orange"></i>
            Mandatory QC Test Protocol
          </h3>
          <span class="text-xs text-slate-400">Click any reading to edit manually, or switch to Voice Mode.</span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-brand-navy/90 text-slate-400 font-semibold border-b border-brand-steel/50 uppercase tracking-wider">
              <tr>
                <th class="py-3 px-3 w-12 text-center">#</th>
                <th class="py-3 px-4 min-w-[180px]">Test Parameter</th>
                <th class="py-3 px-3 min-w-[150px]">Nominal Criterion</th>
                <th class="py-3 px-3 min-w-[150px]">Multimeter / Logged Value</th>
                <th class="py-3 px-3 text-center min-w-[110px]">Status</th>
                <th class="py-3 px-3 text-right w-28">Quick Action</th>
              </tr>
            </thead>
            <tbody id="checklistTableBody" class="divide-y divide-brand-steel/30 text-slate-200">
              <!-- Dynamically populated rows -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- Bottom Step Navigation to Photo/Signature -->
      <div class="flex justify-end gap-3 pt-2">
        <button onclick="switchTab('voice')" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold flex items-center gap-2 transition">
          <i data-lucide="mic" class="w-4 h-4 text-brand-orange"></i>
          Test via Voice HUD
        </button>
        <button onclick="switchTab('evidence')" class="px-6 py-2.5 rounded-xl bg-brand-orange hover:bg-orange-600 text-white text-xs font-bold shadow-lg shadow-orange-500/20 flex items-center gap-2 transition">
          <span>Proceed to Evidence & Sign-Off</span>
          <i data-lucide="arrow-right" class="w-4 h-4"></i>
        </button>
      </div>

    </section>

    <!-- TAB 2: HANDS-FREE VOICE ASSISTANT HUD -->
    <section id="pane-voice" class="hidden space-y-6">
      
      <!-- Voice HUD Top Control Banner -->
      <div class="bg-gradient-to-r from-brand-card to-brand-navy border border-brand-steel/80 rounded-2xl p-4 sm:p-6 shadow-2xl relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-brand-orange/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="flex flex-col md:flex-row items-center justify-between gap-4">
          <div class="flex items-center space-x-4">
            <div id="micVisualizerCircle" class="w-16 h-16 rounded-2xl bg-brand-navy border-2 border-brand-steel flex items-center justify-center shadow-lg transition-all duration-300">
              <i id="micPulseIcon" data-lucide="mic" class="w-8 h-8 text-slate-400 transition-colors"></i>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <h2 class="text-xl font-black text-white tracking-tight">VOICE-GUIDED FAT CO-PILOT</h2>
                <span id="voiceStatusBadge" class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-800 text-slate-400 border border-slate-700">
                  STANDBY
                </span>
              </div>
              <p class="text-xs text-slate-400 mt-1">
                Audio instructions stream into your Bluetooth headset. Speak multimeter readings hands-free.
              </p>
            </div>
          </div>

          <!-- Audio Waveform (Visible during listening/speaking) -->
          <div id="audioWaveBars" class="hidden flex items-end gap-1.5 h-10 px-4 py-1 bg-brand-navy/60 rounded-xl border border-brand-steel/40">
            <div class="wave-bar w-1.5 bg-brand-orange rounded-full h-2 animate-wave"></div>
            <div class="wave-bar w-1.5 bg-brand-orange rounded-full h-5 animate-wave"></div>
            <div class="wave-bar w-1.5 bg-brand-orange rounded-full h-8 animate-wave"></div>
            <div class="wave-bar w-1.5 bg-brand-orange rounded-full h-4 animate-wave"></div>
            <div class="wave-bar w-1.5 bg-brand-orange rounded-full h-7 animate-wave"></div>
          </div>

          <!-- Main Start/Stop Voice Button -->
          <div class="flex items-center gap-3">
            <button id="toggleVoiceBtn" onclick="toggleVoiceAssistant()" class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-brand-orange to-amber-600 hover:from-orange-600 hover:to-amber-700 text-white font-bold text-sm shadow-xl shadow-orange-500/25 flex items-center gap-2.5 transition transform active:scale-95">
              <i data-lucide="play" id="voiceBtnIcon" class="w-5 h-5 fill-current"></i>
              <span id="voiceBtnLabel">Start Hands-Free Session</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Active Step Spotlight Card -->
      <div class="bg-brand-card/90 border-2 border-brand-steel/80 rounded-2xl p-6 shadow-2xl relative">
        <div class="flex items-center justify-between pb-3 border-b border-brand-steel/50">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-brand-orange animate-ping"></span>
            <span class="text-xs font-bold uppercase tracking-wider text-brand-orange">Active Step Under Test</span>
          </div>
          <span id="voiceStepCounter" class="font-mono-code text-xs px-2.5 py-1 rounded-md bg-brand-navy border border-brand-steel text-slate-300">
            Step 1 of 8
          </span>
        </div>

        <div class="py-6 space-y-4">
          <h3 id="voiceActiveTitle" class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight leading-snug">
            Measure Incoming Supply Voltage (R to Y)
          </h3>

          <div class="flex flex-wrap gap-4 text-xs font-mono-code">
            <div class="bg-brand-navy/90 border border-brand-steel px-3 py-2 rounded-xl">
              <span class="text-slate-400 block text-[10px] uppercase">Acceptable Range</span>
              <span id="voiceActiveNominal" class="text-brand-orange font-bold text-sm">400V - 425V AC ±2%</span>
            </div>
            <div class="bg-brand-navy/90 border border-brand-steel px-3 py-2 rounded-xl">
              <span class="text-slate-400 block text-[10px] uppercase">Last Spoken / Logged</span>
              <span id="voiceActiveValue" class="text-emerald-400 font-bold text-sm">Pending Reading...</span>
            </div>
          </div>

          <!-- Spoken Transcript Feedback Bubble -->
          <div class="bg-brand-navy/70 border border-brand-steel/60 rounded-xl p-3.5 flex items-start gap-3">
            <i data-lucide="message-square" class="w-4 h-4 text-brand-orange mt-0.5 flex-shrink-0"></i>
            <div>
              <span class="text-[11px] uppercase tracking-wider text-slate-400 font-bold block">Live Audio Transcript:</span>
              <p id="liveTranscript" class="text-sm font-medium text-slate-200 italic mt-0.5">
                "Listening for your command... (e.g. '415 volts' or 'pass')"
              </p>
            </div>
          </div>
        </div>

        <!-- Controls: Repeat, Next, Previous, Manual Override -->
        <div class="flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-brand-steel/50">
          <div class="flex items-center gap-2">
            <button onclick="voiceNavigate(-1)" class="p-2.5 rounded-xl bg-brand-navy hover:bg-slate-800 border border-brand-steel text-slate-300 transition" title="Previous Step">
              <i data-lucide="chevron-left" class="w-5 h-5"></i>
            </button>
            <button onclick="repeatCurrentPrompt()" class="px-4 py-2.5 rounded-xl bg-brand-navy hover:bg-slate-800 border border-brand-steel text-slate-200 text-xs font-semibold flex items-center gap-2 transition">
              <i data-lucide="volume-2" class="w-4 h-4 text-brand-orange"></i>
              Repeat Prompt
            </button>
            <button onclick="voiceNavigate(1)" class="p-2.5 rounded-xl bg-brand-navy hover:bg-slate-800 border border-brand-steel text-slate-300 transition" title="Next Step">
              <i data-lucide="chevron-right" class="w-5 h-5"></i>
            </button>
          </div>

          <!-- Touch Override Shortcuts -->
          <div class="flex items-center gap-2">
            <button onclick="recordSpokenResult('PASSED')" class="px-4 py-2.5 rounded-xl bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 border border-emerald-500/30 text-xs font-bold flex items-center gap-1.5 transition">
              <i data-lucide="check" class="w-4 h-4"></i>
              Pass
            </button>
            <button onclick="recordSpokenResult('FAILED')" class="px-4 py-2.5 rounded-xl bg-rose-500/20 hover:bg-rose-500/30 text-rose-300 border border-rose-500/30 text-xs font-bold flex items-center gap-1.5 transition">
              <i data-lucide="x" class="w-4 h-4"></i>
              Fail
            </button>
          </div>
        </div>
      </div>

      <!-- Voice Commands Cheatsheet -->
      <div class="bg-brand-card/60 border border-brand-steel/40 rounded-2xl p-5">
        <h4 class="font-bold text-xs uppercase tracking-wider text-slate-300 mb-3 flex items-center gap-2">
          <i data-lucide="mic-2" class="w-4 h-4 text-brand-orange"></i>
          Spoken Command Vocabulary Guide (Shop-Floor Optimized)
        </h4>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 text-xs">
          <div class="p-2.5 rounded-xl bg-brand-navy/80 border border-brand-steel/40">
            <span class="text-brand-orange font-bold block">"415 Volts" / "0.8 Ohms"</span>
            <span class="text-slate-400 text-[11px]">Automatically records the reading and validates nominal range.</span>
          </div>
          <div class="p-2.5 rounded-xl bg-brand-navy/80 border border-brand-steel/40">
            <span class="text-emerald-400 font-bold block">"Pass" / "Check" / "OK"</span>
            <span class="text-slate-400 text-[11px]">Marks parameter as Passed and auto-advances to next step.</span>
          </div>
