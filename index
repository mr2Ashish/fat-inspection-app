    function initSpeechRecognition() {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SpeechRecognition) {
        console.warn("Speech Recognition API not supported in this browser.");
        return;
      }

      recognition = new SpeechRecognition();
      recognition.continuous = true;
      recognition.interimResults = false;
      recognition.lang = 'en-IN'; // Optimized for Indian technical English accents

      recognition.onstart = () => {
        setVoiceIndicator(true, "LISTENING", "Mic Active");
      };

      recognition.onresult = (event) => {
        const transcript = event.results[event.results.length - 1][0].transcript.trim();
        handleSpokenAudioInput(transcript);
      };

      recognition.onerror = (event) => {
        console.warn("Speech recognition error:", event.error);
        if (event.error === 'not-allowed') {
          showToast("Microphone permission denied. Please allow mic in browser settings.", "error");
          stopVoiceAssistant();
        }
      };

      recognition.onend = () => {
        // Auto-restart if user still has voice session active
        if (isVoiceActive) {
          try {
            recognition.start();
          } catch(e) {
            console.log("Recognition restarting...");
          }
        } else {
          setVoiceIndicator(false, "STANDBY", "Mic Idle");
        }
      };
    }

    function startVoiceHUDDirectly() {
      switchTab('voice');
      if (!isVoiceActive) {
        toggleVoiceAssistant();
      }
    }

    function toggleVoiceAssistant() {
      if (!recognition && !(window.SpeechRecognition || window.webkitSpeechRecognition)) {
        showToast("Voice Recognition is not supported by your browser. Use Google Chrome or Safari.", "error");
        return;
      }

      isVoiceActive = !isVoiceActive;

      const btnIcon = document.getElementById('voiceBtnIcon');
      const btnLabel = document.getElementById('voiceBtnLabel');

      if (isVoiceActive) {
        btnIcon.setAttribute('data-lucide', 'square');
        btnLabel.innerText = "Stop Hands-Free Session";
        try {
          recognition.start();
        } catch(e) {
          console.log(e);
        }
        playAudioChime(880, 0.15); // High beep
        promptCurrentActiveStep();
      } else {
        stopVoiceAssistant();
      }

      if (window.lucide) lucide.createIcons();
    }

    function stopVoiceAssistant() {
      isVoiceActive = false;
      synth.cancel();
      if (recognition) {
        try { recognition.stop(); } catch(e){}
      }
      setVoiceIndicator(false, "STANDBY", "Mic Idle");
      document.getElementById('voiceBtnIcon').setAttribute('data-lucide', 'play');
      document.getElementById('voiceBtnLabel').innerText = "Start Hands-Free Session";
