    /* =========================================================
     * MODULE 3: DIGITAL SIGNATURE PAD (HTML5 CANVAS)
     * ========================================================= */

    function initSignatureCanvas() {
      signatureCanvas = document.getElementById('signaturePad');
      signaturePadCtx = signatureCanvas.getContext('2d');
      resizeSignatureCanvas();

      // Event listeners for touch and pointer
      signatureCanvas.addEventListener('pointerdown', startSigDraw);
      signatureCanvas.addEventListener('pointermove', drawSig);
      window.addEventListener('pointerup', stopSigDraw);

      window.addEventListener('resize', () => {
        resizeSignatureCanvas();
      });
    }

    function resizeSignatureCanvas() {
      if (!signatureCanvas) return;
      const rect = signatureCanvas.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) return;

      // Save previous drawing if any
      const tempImage = signaturePadCtx ? signatureCanvas.toDataURL() : null;

      signatureCanvas.width = rect.width;
      signatureCanvas.height = rect.height;

      // Configure pen
      signaturePadCtx.lineWidth = 2.5;
      signaturePadCtx.lineCap = 'round';
      signaturePadCtx.lineJoin = 'round';
      signaturePadCtx.strokeStyle = '#0b192c'; // Dark navy ink

      if (tempImage) {
        const img = new Image();
        img.onload = () => signaturePadCtx.drawImage(img, 0, 0);
        img.src = tempImage;
      }
    }

    function startSigDraw(e) {
      isDrawingSignature = true;
      document.getElementById('sigPlaceholder').classList.add('hidden');
      const rect = signatureCanvas.getBoundingClientRect();
      signaturePadCtx.beginPath();
      signaturePadCtx.moveTo(e.clientX - rect.left, e.clientY - rect.top);
    }

    function drawSig(e) {
      if (!isDrawingSignature) return;
      const rect = signatureCanvas.getBoundingClientRect();
      signaturePadCtx.lineTo(e.clientX - rect.left, e.clientY - rect.top);
      signaturePadCtx.stroke();
    }

    function stopSigDraw() {
      isDrawingSignature = false;
    }

    function clearSignatureCanvas() {
      if (!signaturePadCtx || !signatureCanvas) return;
      signaturePadCtx.clearRect(0, 0, signatureCanvas.width, signatureCanvas.height);
      document.getElementById('sigPlaceholder').classList.remove('hidden');
    }

    function isSignatureEmpty() {
      if (!signatureCanvas) return true;
      const pixelBuffer = new Uint32Array(
        signaturePadCtx.getImageData(0, 0, signatureCanvas.width, signatureCanvas.height).data.buffer
      );
      return !pixelBuffer.some(color => color !== 0);
    }

