    // Read the active step into technician's earpiece
    function promptCurrentActiveStep() {
      if (activeVoiceIndex >= currentChecklist.length) {
        speakText("All panel testing steps are completed. Please inspect visually and capture photos.", () => {
          stopVoiceAssistant();
          switchTab('evidence');
        });
        return;
      }

      updateVoiceHUD();
      const current = currentChecklist[activeVoiceIndex];
      const stepNumber = activeVoiceIndex + 1;
      const textToSpeak = `Step ${stepNumber}: ${current.spokenPrompt}. Nominal is ${current.nominal}. Please say reading, or say Pass or Fail.`;

      speakText(textToSpeak);
    }

    function speakText(text, onComplete) {
      synth.cancel(); // Stop pending speech
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.rate = 1.0;
      utterance.pitch = 1.0;
      utterance.lang = 'en-IN';

      utterance.onstart = () => {
        setVoiceIndicator(true, "SPEAKING", "App Speaking");
      };

      utterance.onend = () => {
        if (isVoiceActive) {
          setVoiceIndicator(true, "LISTENING", "Listening...");
        }
        if (onComplete) onComplete();
      };

      synth.speak(utterance);
    }

    function repeatCurrentPrompt() {
      promptCurrentActiveStep();
    }

    function voiceNavigate(delta) {
      const newIndex = activeVoiceIndex + delta;
      if (newIndex >= 0 && newIndex < currentChecklist.length) {
        activeVoiceIndex = newIndex;
        promptCurrentActiveStep();
      }
    }

    // Spoken Audio Parser: Handles Multimeter Numbers, Pass/Fail, Navigation
    function handleSpokenAudioInput(rawText) {
      const text = rawText.toLowerCase().trim();
      document.getElementById('liveTranscript').innerText = `"${rawText}"`;

      // 1. Navigation / Flow commands
      if (text.includes("repeat") || text.includes("again") || text.includes("what")) {
        promptCurrentActiveStep();
        return;
      }

      if (text.includes("next step") || text.includes("skip")) {
        activeVoiceIndex = Math.min(activeVoiceIndex + 1, currentChecklist.length - 1);
        promptCurrentActiveStep();
        return;
      }

      if (text.includes("previous") || text.includes("go back")) {
        activeVoiceIndex = Math.max(activeVoiceIndex - 1, 0);
        promptCurrentActiveStep();
        return;
      }

      if (text.includes("test complete") || text.includes("finish") || text.includes("done")) {
        speakText("Inspection complete. Proceeding to digital sign-off.", () => {
          stopVoiceAssistant();
          switchTab('evidence');
        });
        return;
      }

      // 2. Pass / Fail Keywords
      if (text.includes("pass") || text.includes("passed") || text.includes("check") || text.includes("ok") || text.includes("verified") || text.includes("good")) {
        recordSpokenResult('PASSED', rawText);
        return;
      }

      if (text.includes("fail") || text.includes("failed") || text.includes("defect") || text.includes("rejected")) {
        recordSpokenResult('FAILED', rawText);
        return;
      }

      // 3. Numeric multimeter value extraction (e.g., "415.2 volts", "0.8 ohms", "24.1")
      const numberRegex = /(\d+(\.\d+)?)/;
      const match = text.match(numberRegex);
      if (match) {
        const numericVal = match[0];
        const unit = currentChecklist[activeVoiceIndex].unit || "";
        const formattedValue = `${numericVal} ${unit}`.trim();
        recordSpokenResult('PASSED', formattedValue);
        return;
      }

      // Default: Log whatever was spoken
      recordSpokenResult('PASSED', rawText);
    }

    function recordSpokenResult(verdict, valueText = null) {
      const step = currentChecklist[activeVoiceIndex];
      step.status = verdict;
      step.value = valueText || (verdict === 'PASSED' ? 'Passed via Voice' : 'Failed via Voice');

      renderChecklistTable();
      updateChecklistStats();
      playAudioChime(520, 0.1);

      const confirmMessage = `Logged ${step.value}. Advancing to next test.`;
      speakText(confirmMessage, () => {
        activeVoiceIndex++;
        promptCurrentActiveStep();
      });
    }

    function updateVoiceHUD() {
      if (activeVoiceIndex < currentChecklist.length) {
        const step = currentChecklist[activeVoiceIndex];
        document.getElementById('voiceStepCounter').innerText = `Step ${activeVoiceIndex + 1} of ${currentChecklist.length}`;
        document.getElementById('voiceActiveTitle').innerText = step.name;
        document.getElementById('voiceActiveNominal').innerText = step.nominal;
        document.getElementById('voiceActiveValue').innerText = step.value || 'Awaiting Spoken Reading...';
      }
    }

    // Audio chime tone using native Web Audio API (Zero external MP3 dependency)
    function playAudioChime(freq = 600, duration = 0.1) {
      try {
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.frequency.value = freq;
        osc.type = 'sine';
        gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + duration);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + duration);
      } catch (e) {
        // AudioContext not allowed without gesture
      }
    }

