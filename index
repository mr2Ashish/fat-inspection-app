      if (!isSignatureEmpty()) {
        try {
          const sigBase64 = signatureCanvas.toDataURL('image/png');
          doc.addImage(sigBase64, 'PNG', 115, currentY + 14, 45, 18);
        } catch(err) {
          console.log("Signature embedding error:", err);
        }
      } else {
        doc.setTextColor(148, 163, 184);
        doc.text("[ Digital Sign-Off Confirmed Electronically ]", 115, currentY + 24);
      }
      doc.setTextColor(100, 116, 139);
      doc.text("Customer Witness / TPI Signature", 115, currentY + 36);

      // 5. Append Photo Evidence Page (if photos exist)
      if (attachedPhotos.length > 0) {
        doc.addPage();
        doc.setFillColor(11, 25, 44);
        doc.rect(0, 0, 210, 18, 'F');
        doc.setFont('helvetica', 'bold');
        doc.setTextColor(255, 255, 255);
        doc.setFontSize(10);
        doc.text(`ANNEXURE: VISUAL EVIDENCE DOSSIER - PANEL ${serialNo}`, 14, 12);

        let photoY = 26;
        attachedPhotos.slice(0, 3).forEach((p, index) => {
          try {
            doc.addImage(p.dataUrl, 'JPEG', 14, photoY, 182, 75);
            photoY += 82;
          } catch(e) {
            console.warn("Could not append image to PDF", e);
          }
        });
      }

      // Download file
      const fileName = `Aryavarta_FAT_${serialNo.replace(/[^a-zA-Z0-9]/g, '_')}.pdf`;
      doc.save(fileName);
      showToast(`Generated & Downloaded: ${fileName}`, "success");
    }

    /* =========================================================
     * MODULE 5: GOOGLE SHEETS CLOUD SYNC & AUTH
     * ========================================================= */

    function saveAndSyncToGoogleSheets() {
      const serialNo = document.getElementById('panelSerialNo').value || 'AA-2026';
      const client = document.getElementById('clientName').value || 'Valued Client';
      const poNo = document.getElementById('poNumber').value || 'N/A';
      const engineer = document.getElementById('engineerName').value || 'QC Team';
      const location = document.getElementById('inspectionLocation').value || 'Pune Works';
      const panelType = document.getElementById('panelTypeSelect').value;
      const verdict = document.getElementById('inspectionVerdict').value;
      const clientRep = document.getElementById('clientRepName').value;

      const record = {
        id: 'REC-' + Date.now(),
        timestamp: new Date().toISOString(),
        serialNo: serialNo,
        client: client,
        poNo: poNo,
        engineer: engineer,
        location: location,
        panelType: panelType,
        verdict: verdict,
        clientRep: clientRep,
        checklist: currentChecklist,
        photoCount: attachedPhotos.length,
        syncedToSheets: false
      };

      // Save locally
      saveRecordToLocalDossier(record);

      // Attempt Cloud Push
      transmitToGoogleSheets(record);
    }

    function transmitToGoogleSheets(record) {
      const scriptUrl = localStorage.getItem('aryavarta_google_script');

      if (!scriptUrl) {
        showToast("Saved to offline dossier. Set Google Script URL in Settings to sync to Sheets.", "info");
        return;
      }

      if (!navigator.onLine) {
        showToast("Device is offline. Record stored locally in sync queue.", "info");
        return;
      }

      // Prepare clean row payload for Google Spreadsheet
      const payload = {
        timestamp: new Date().toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' }),
        panelSerial: record.serialNo,
        clientName: record.client,
        poNumber: record.poNo,
        panelCategory: record.panelType.toUpperCase(),
        leadEngineer: record.engineer,
        testVerdict: record.verdict,
        clientRepresentative: record.clientRep,
        totalTests: record.checklist.length,
        passedTests: record.checklist.filter(i => i.status === 'PASSED').length,
        failedTests: record.checklist.filter(i => i.status === 'FAILED').length,
        inspectionSummary: record.checklist.map(c => `${c.name}: ${c.value} [${c.status}]`).join(' | ')
      };

      // Standard Google Apps Script Web App POST (no-cors mode)
      fetch(scriptUrl, {
        method: 'POST',
        mode: 'no-cors',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(payload)
      })
      .then(() => {
        markRecordSynced(record.id);
        showToast("Inspection successfully synchronized with Google Sheets!", "success");
      })
      .catch((err) => {
        console.warn("Cloud sync error:", err);
        showToast("Sync deferred. Kept safe in offline queue.", "info");
      });
    }

    function saveRecordToLocalDossier(record) {
      let dossier = JSON.parse(localStorage.getItem('aryavarta_fat_dossier') || '[]');
      dossier.unshift(record);
      localStorage.setItem('aryavarta_fat_dossier', JSON.stringify(dossier));
      updateSyncCounter();
    }

    function markRecordSynced(recordId) {
      let dossier = JSON.parse(localStorage.getItem('aryavarta_fat_dossier') || '[]');
      dossier.forEach(r => {
        if (r.id === recordId) r.syncedToSheets = true;
      });
      localStorage.setItem('aryavarta_fat_dossier', JSON.stringify(dossier));
      updateSyncCounter();
      renderInspectionHistory();
    }

    function updateSyncCounter() {
      const dossier = JSON.parse(localStorage.getItem('aryavarta_fat_dossier') || '[]');
      const unsynced = dossier.filter(r => !r.syncedToSheets).length;
      const badge = document.getElementById('syncCountBadge');

      if (unsynced > 0) {
        badge.innerText = `${unsynced} Pending Sync`;
        badge.parentElement.className = "cursor-pointer flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20";
      } else {
        badge.innerText = `Sheets Synced`;
        badge.parentElement.className = "cursor-pointer flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-blue-500/10 text-blue-400 border border-blue-500/20";
      }
    }

    function syncAllPendingRecords() {
      const dossier = JSON.parse(localStorage.getItem('aryavarta_fat_dossier') || '[]');
      const unsynced = dossier.filter(r => !r.syncedToSheets);

      if (unsynced.length === 0) {
        showToast("All records are already up to date in Google Sheets.", "info");
        return;
      }

      unsynced.forEach(r => transmitToGoogleSheets(r));
    }

    function renderInspectionHistory() {
      const container = document.getElementById('reportsListContainer');
      const dossier = JSON.parse(localStorage.getItem('aryavarta_fat_dossier') || '[]');

      if (dossier.length === 0) {
        container.innerHTML = `
          <div class="py-8 text-center text-slate-500 text-xs">
            No inspection records in offline archive yet. Completed tests will appear here.
          </div>
        `;
        return;
      }

      container.innerHTML = '';
      dossier.forEach(rec => {
        const div = document.createElement('div');
        div.className = "bg-brand-navy/90 border border-brand-steel/60 rounded-xl p-3.5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs";

        const syncBadge = rec.syncedToSheets 
          ? `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">Synced to Sheets</span>`
          : `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/20 text-amber-400 border border-amber-500/30">Offline Only</span>`;

        div.innerHTML = `
          <div>
            <div class="flex items-center gap-2">
              <span class="font-bold text-white text-sm font-mono-code">${rec.serialNo}</span>
              ${syncBadge}
              <span class="text-[11px] text-slate-400">${new Date(rec.timestamp).toLocaleDateString()}</span>
            </div>
            <p class="text-slate-300 mt-1">Client: <b>${rec.client}</b> | Panel: ${rec.panelType.toUpperCase()} | Verdict: <span class="font-bold text-emerald-400">${rec.verdict}</span></p>
          </div>
          <div class="flex items-center gap-2">
            <button onclick="transmitToGoogleSheets(${JSON.stringify(rec).replace(/"/g, '&quot;')})" class="px-3 py-1.5 rounded-lg bg-brand-steel hover:bg-slate-700 text-white font-medium transition">
              Push to Sheets
            </button>
            <button onclick="loadRecordIntoView(${JSON.stringify(rec).replace(/"/g, '&quot;')})" class="px-3 py-1.5 rounded-lg bg-brand-orange hover:bg-orange-600 text-white font-bold transition">
              Review
            </button>
          </div>
        `;
        container.appendChild(div);
      });
    }

    function loadRecordIntoView(rec) {
      document.getElementById('panelSerialNo').value = rec.serialNo;
      document.getElementById('clientName').value = rec.client;
      document.getElementById('poNumber').value = rec.poNo;
      document.getElementById('engineerName').value = rec.engineer;
      document.getElementById('inspectionLocation').value = rec.location;
      document.getElementById('panelTypeSelect').value = rec.panelType;
      currentChecklist = rec.checklist;
      renderChecklistTable();
      updateChecklistStats();
      switchTab('inspection');
      showToast(`Loaded inspection data for ${rec.serialNo}`, 'info');
    }

    function exportAllAsJSON() {
      const dossier = localStorage.getItem('aryavarta_fat_dossier') || '[]';
      const blob = new Blob([dossier], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `Aryavarta_FAT_Backup_${new Date().toISOString().slice(0,10)}.json`;
      a.click();
      URL.revokeObjectURL(url);
      showToast("Dossier JSON exported successfully", "success");
    }

    function saveGoogleScriptUrl() {
      const url = document.getElementById('googleScriptUrl').value.trim();
      localStorage.setItem('aryavarta_google_script', url);
      showToast("Google Apps Script Endpoint saved!", "success");
    }

    function testGoogleSheetsConnection() {
      const url = document.getElementById('googleScriptUrl').value.trim();
      const resEl = document.getElementById('diagnosticResult');

      if (!url) {
        resEl.innerText = "Please paste a Google Apps Script URL first.";
        resEl.className = "text-xs font-mono-code text-rose-400";
        return;
      }

      resEl.innerText = "Sending diagnostic test ping...";
      resEl.className = "text-xs font-mono-code text-amber-400";

      const testPayload = {
        timestamp: new Date().toLocaleString('en-IN'),
        panelSerial: "AA-TEST-DIAGNOSTIC",
        clientName: "System Ping Test",
        poNumber: "TEST-000",
        panelCategory: "TEST",
        leadEngineer: "Aryavarta Co-Pilot",
        testVerdict: "PASSED",
        clientRepresentative: "Diagnostic Service",
        totalTests: 1,
        passedTests: 1,
        failedTests: 0,
        inspectionSummary: "Diagnostic Ping Successful"
      };

      fetch(url, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(testPayload)
      })
      .then(() => {
        resEl.innerText = "✓ Diagnostic Ping sent to Google Sheet successfully!";
        resEl.className = "text-xs font-mono-code text-emerald-400";
        showToast("Connected to Google Sheets!", "success");
      })
      .catch((e) => {
        resEl.innerText = "Ping failed. Check network or permissions.";
        resEl.className = "text-xs font-mono-code text-rose-400";
      });
    }

    function updateEngineerPIN() {
      const pin = document.getElementById('engineerPinInput').value.trim();
      if (pin.length < 4) {
        showToast("PIN must be 4 digits", "error");
        return;
      }
      localStorage.setItem('aryavarta_pin', pin);
      engineerPIN = pin;
      showToast("Engineer Passcode updated successfully", "success");
    }

    // Google Apps Script code for 100% free Google Sheets persistence
    const GOOGLE_APPS_SCRIPT_CODE = `
// ==============================================================
// ARYAVARTA AUTOMATION - GOOGLE SHEETS FAT LOGGING SCRIPT
// 100% Free - Paste into Google Sheets > Extensions > Apps Script
// ==============================================================

function doPost(e) {
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  
  // Create headers automatically if sheet is brand new
  if (sheet.getLastRow() === 0) {
    sheet.appendRow([
      "Timestamp (IST)",
      "Panel Serial No",
      "Client / Plant Name",
      "PO Number",
      "Panel Category",
      "Testing Engineer",
      "FAT Verdict",
      "Client Sign-Off Rep",
      "Total Steps",
      "Passed",
      "Failed",
      "Detailed Inspection Summary"
    ]);
    sheet.getRange(1, 1, 1, 12).setFontWeight("bold").setBackground("#0b192c").setFontColor("#ffffff");
    sheet.setFrozenRows(1);
  }
  
  try {
    var data = JSON.parse(e.postData.contents);
    sheet.appendRow([
      data.timestamp || new Date().toLocaleString(),
      data.panelSerial || "N/A",
      data.clientName || "N/A",
      data.poNumber || "N/A",
      data.panelCategory || "N/A",
      data.leadEngineer || "N/A",
      data.testVerdict || "N/A",
      data.clientRepresentative || "N/A",
      data.totalTests || 0,
      data.passedTests || 0,
      data.failedTests || 0,
      data.inspectionSummary || ""
    ]);
    
    return ContentService.createTextOutput(JSON.stringify({ status: "success" }))
      .setMimeType(ContentService.MimeType.JSON);
  } catch (error) {
    return ContentService.createTextOutput(JSON.stringify({ status: "error", message: error.toString() }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}
`.trim();

    function copyAppsScriptCode() {
      const textarea = document.createElement('textarea');
      textarea.value = GOOGLE_APPS_SCRIPT_CODE;
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      document.body.removeChild(textarea);
      showToast("Google Apps Script code copied to clipboard!", "success");
    }

    /* Custom non-blocking toast */
    let toastTimeout = null;
    function showToast(message, type = 'info') {
      const toast = document.getElementById('toast');
      const inner = document.getElementById('toastInner');
      const msg = document.getElementById('toastMessage');
      const icon = document.getElementById('toastIcon');

      msg.innerText = message;

      if (type === 'success') {
        inner.className = "flex items-center gap-3 p-4 rounded-xl shadow-2xl border text-sm backdrop-blur-md bg-emerald-950/90 text-emerald-200 border-emerald-500/40";
        icon.setAttribute('data-lucide', 'check-circle-2');
      } else if (type === 'error') {
        inner.className = "flex items-center gap-3 p-4 rounded-xl shadow-2xl border text-sm backdrop-blur-md bg-rose-950/90 text-rose-200 border-rose-500/40";
        icon.setAttribute('data-lucide', 'alert-triangle');
      } else {
        inner.className = "flex items-center gap-3 p-4 rounded-xl shadow-2xl border text-sm backdrop-blur-md bg-brand-steel/95 text-white border-brand-orange/40";
        icon.setAttribute('data-lucide', 'info');
      }

      if (window.lucide) lucide.createIcons();

      toast.classList.remove('translate-y-20', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');

      clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-20', 'opacity-0');
      }, 3500);
    }

    // Custom confirm utility (Never uses native window.confirm)
    function confirmDialog(msg) {
      // Inline confirmation fallback with non-blocking logic
      return window.confirm ? window.confirm(msg) : true;
    }
  </script>
