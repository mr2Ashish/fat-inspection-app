    window.addEventListener('DOMContentLoaded', () => {
      // Initialize icons
      if (window.lucide) lucide.createIcons();

      // Load initial checklist
      loadChecklistTemplate('vfd');

      // Initialize Signature Pad
      initSignatureCanvas();

      // Load saved Google Script URL
      if (googleScriptUrl) {
        document.getElementById('googleScriptUrl').value = googleScriptUrl;
      }

      // Network online/offline monitoring
      window.addEventListener('online', updateNetworkStatus);
      window.addEventListener('offline', updateNetworkStatus);
      updateNetworkStatus();

      // Load offline report counter
      updateSyncCounter();

      // Setup Web Speech Recognition
      initSpeechRecognition();
    });

    // Network status updater
    function updateNetworkStatus() {
      const badge = document.getElementById('netStatusBadge');
      if (navigator.onLine) {
        badge.className = "flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20";
        badge.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span><span class="hidden md:inline font-medium">Online</span>`;
      } else {
        badge.className = "flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-rose-500/10 text-rose-400 border border-rose-500/20";
        badge.innerHTML = `<span class="w-2 h-2 rounded-full bg-rose-500"></span><span class="hidden md:inline font-medium">Offline (Storage Active)</span>`;
      }
    }

    // Tab Switcher
    function switchTab(tabId) {
      const tabs = ['inspection', 'voice', 'evidence', 'reports', 'settings'];
      tabs.forEach(t => {
        const pane = document.getElementById(`pane-${t}`);
        const btn = document.getElementById(`tab-${t}`);
        if (t === tabId) {
          pane.classList.remove('hidden');
          btn.className = 'tab-btn flex-1 min-w-[100px] py-3 px-3 text-center border-b-2 border-brand-orange text-brand-orange flex items-center justify-center gap-1.5 transition font-semibold';
        } else {
          pane.classList.add('hidden');
          btn.className = 'tab-btn flex-1 min-w-[100px] py-3 px-3 text-center border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex items-center justify-center gap-1.5 transition';
        }
      });

      if (tabId === 'voice') {
        updateVoiceHUD();
      } else if (tabId === 'evidence') {
        resizeSignatureCanvas();
      } else if (tabId === 'reports') {
        renderInspectionHistory();
      }

      if (window.lucide) lucide.createIcons();
    }

    // Load and render selected checklist template
    function loadChecklistTemplate(categoryKey) {
      const template = CHECKLIST_TEMPLATES[categoryKey] || CHECKLIST_TEMPLATES.vfd;
      // Deep clone to allow editing
      currentChecklist = JSON.parse(JSON.stringify(template));
      renderChecklistTable();
      updateChecklistStats();
      activeVoiceIndex = 0;
    }

    // Render Checklist Table Rows
    function renderChecklistTable() {
      const tbody = document.getElementById('checklistTableBody');
      tbody.innerHTML = '';

      currentChecklist.forEach((item, index) => {
        const tr = document.createElement('tr');
        tr.className = `border-b border-brand-steel/30 hover:bg-brand-navy/60 transition ${index === activeVoiceIndex && isVoiceActive ? 'bg-brand-orange/10' : ''}`;

        // Status Badge Style
        let statusBadge = `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-800 text-slate-400 border border-slate-700">PENDING</span>`;
        if (item.status === 'PASSED') {
          statusBadge = `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">PASSED</span>`;
        } else if (item.status === 'FAILED') {
          statusBadge = `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-rose-500/20 text-rose-400 border border-rose-500/30">FAILED</span>`;
        }

        tr.innerHTML = `
          <td class="py-3 px-3 text-center font-mono-code text-slate-400">${item.id}</td>
          <td class="py-3 px-4 font-semibold text-white">
            ${item.name}
