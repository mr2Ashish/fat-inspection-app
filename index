        { id: 2, name: "ACB Shunt Trip & Undervoltage", nominal: "Trips under 50ms", spokenPrompt: "Verify electrical operation of ACB shunt trip release.", value: "", status: "PENDING", unit: "ms" },
        { id: 3, name: "CT / PT Ratio & Polarity", nominal: "Ratio Verified as per SLD", spokenPrompt: "Verify Current Transformer ratio and polarity.", value: "", status: "PENDING", unit: "" },
        { id: 4, name: "Multifunction Meter (MFM) Calibration", nominal: "Class 0.5s Accuracy", spokenPrompt: "Check digital meter voltage, current, and frequency readings.", value: "", status: "PENDING", unit: "" },
