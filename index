    function updateChecklistStats() {
      const total = currentChecklist.length;
      const passed = currentChecklist.filter(i => i.status === 'PASSED').length;
      const failed = currentChecklist.filter(i => i.status === 'FAILED').length;
      const pending = total - (passed + failed);

      document.getElementById('statTotalSteps').innerText = total;
      document.getElementById('statPassedSteps').innerText = passed;
      document.getElementById('statFailedSteps').innerText = failed;
      document.getElementById('statPendingSteps').innerText = pending;

      const pct = total > 0 ? Math.round(((passed + failed) / total) * 100) : 0;
      document.getElementById('checklistProgressBar').style.width = `${pct}%`;
    }

