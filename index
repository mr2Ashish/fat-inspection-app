        { id: 4, name: "Analog Input (AI) 4-20mA Calibration", nominal: "Linear 0 to 100% Span", spokenPrompt: "Inject 12mA signal and verify PLC register shows 50 percent.", value: "", status: "PENDING", unit: "mA" },
